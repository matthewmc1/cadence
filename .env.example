# Cadence server configuration.
# Copy to `.env` and fill in as needed — `.env` is gitignored. The server reads
# these from the process environment (it does not auto-load .env; export them or
# use your process manager / `env $(cat .env | xargs)`).

# ---- core ----
CADENCE_ADDR=:8088
# `./dev.sh` defaults to the persistent Postgres backend below. Set to `memory`
# only for a throwaway run — the in-memory store is wiped on restart.
CADENCE_BACKEND=postgres               # memory | postgres
# Password for the compose Postgres. REQUIRED by docker-compose.yml (no default
# is baked in); ./dev.sh and make fall back to `cadence` for local dev only.
# `cadence` below is that LOCAL DEV value — pick a real one for any host other
# people can reach (compose only publishes Postgres on 127.0.0.1, but the role
# owns the tables and bypasses RLS, so the password is the whole fence).
# Changing it does NOT alter an already-initialised volume (`make db-reset`).
CADENCE_DB_PASSWORD=cadence
# Points at the docker-compose Postgres by default. `make db-up` starts it.
# (Inside `docker compose up` the app service overrides this with the db host.)
DATABASE_URL=postgres://cadence:cadence@localhost:55432/cadence?sslmode=disable
CADENCE_DB_PORT=55432                   # host port docker-compose maps Postgres to (avoids a local 5432)
CADENCE_PORT=8088                       # host port the compose `app` service binds
CADENCE_AUTO_MIGRATE=true
# Outbox rows older than this are pruned hourly (postgres only). Clients offline
# longer than this re-bootstrap instead of replaying events.
CADENCE_OUTBOX_RETENTION_DAYS=7

# ---- web / CORS + WebSocket origin allowlist ----
# For a private hostname set both to it, e.g.
#   CADENCE_WEB_ORIGINS=cadence.internal   CADENCE_WEB_URL=https://cadence.internal
# (the embedded web app is same-origin, so the allowlist is only the hostnames
# you serve it from — never `*`).
CADENCE_WEB_ORIGINS=localhost:*,127.0.0.1:*
CADENCE_WEB_URL=http://localhost:4173  # fallback base for magic links

# ---- auth ----
CADENCE_COOKIE_SECURE=false            # true behind HTTPS (a private hostname with TLS) — the cookie is then never sent in clear
CADENCE_SESSION_DAYS=30
CADENCE_LOGIN_MINUTES=15
# Return + log the magic link (dev convenience). Default: true only for the
# in-memory backend with no mail provider; false on postgres or with SMTP/Resend.
# Leave unset unless you know why you want it on.
#CADENCE_DEV_AUTH=false
# Who may sign in: open | invite | domains:example.com,other.org
#   invite  → only pre-created accounts (`cadence-server invite you@example.com`,
#             or `make invite EMAIL=…` under compose) and CADENCE_ADMIN_EMAILS
#   domains → invite, plus anyone at the listed email domains
#   open    → anyone who can reach the host (what the memory backend defaults to)
# Default: invite on postgres, open on memory. Unknown addresses get the same
# 200 as known ones and simply never receive a link.
CADENCE_SIGNUP=invite
# Comma-separated addresses that may always sign in — the first account on a
# fresh install, no CLI needed.
CADENCE_ADMIN_EMAILS=

# ---- email (magic-link delivery) ----
# Precedence: SMTP_HOST set → SMTP; else RESEND_API_KEY set → Resend; else links
# are NOT emailed, only logged (dev mailer) — fine for local development.
# Any SMTP server you run or trust (Postfix, Mailcow, a relay). 587 = STARTTLS,
# 465 = implicit TLS. Leave SMTP_USER/SMTP_PASS empty for an unauthenticated relay.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_STARTTLS=true                      # false only for a trusted relay on localhost
# Optional hosted fallback (https://resend.com/api-keys), used when SMTP_HOST is empty.
RESEND_API_KEY=
# Sender address — REQUIRED whenever SMTP or Resend is configured (the server
# refuses to start without it). Use a domain your mail server is allowed to send as.
MAIL_FROM=

# ---- AI (all local; the browser never talks to a model provider directly) ----
# Ollama on the same box: http://localhost:11434 when running the binary
# directly, http://host.docker.internal:11434 from `docker compose up`.
OLLAMA_URL=
# Directory of WebLLM artifacts (see README "On-device AI scheduling") served
# read-only at /models/ — with it set, the browser needs NO internet at all.
# Under compose this host path is mounted into the container automatically.
CADENCE_MODEL_DIR=
CADENCE_AI_POLICY=local                 # local | local+cloud (no cloud provider is wired)

# ---- multi-tenancy / Postgres note ----
# Tenant isolation is enforced by explicit tenant_id predicates on every query
# AND Row-Level Security. RLS alone is bypassed by superuser / BYPASSRLS roles,
# so for production connect the app as a NON-superuser role (defense in depth).
